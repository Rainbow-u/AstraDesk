{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astradesk.local/contracts/vl_relations.schema.json",
  "title": "VLRelations",
  "description": "B 阶段 Qwen-VL 在既有 SceneFacts 之上补充的关系与解释。H01：只能引用已存在的 object_id，不得改写事实清单；输出须过本 schema 校验后才被接受。",
  "type": "object",
  "additionalProperties": false,
  "required": ["relations", "explanation"],
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "predicate", "object_id"],
        "properties": {
          "subject_id": { "type": "string", "minLength": 1 },
          "predicate": {
            "enum": ["left_of", "right_of", "above", "below", "near", "far_from",
                     "adjacent_to", "grouped_with", "blocks"]
          },
          "object_id": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" }
        }
      }
    },
    "explanation": { "type": "string", "minLength": 1 }
  }
}
